# tls-proxy.env — optional overrides for the demo's TLS front.
#
# The proxy reads these from its environment and falls back to the values
# below, which are the demo Pi's. The unit ships no `EnvironmentFile`, so this
# file is documentation by default: copy it and add `EnvironmentFile=` to the
# unit if the front ever has to move. Anything the proxy needs that the
# defaults do not supply — a different bind, a backend behind a prefix — is
# one of these.

# The address the front listens on. Name an address guests can reach; never
# loopback when someone else is joining.
TLS_PROXY_BIND=100.64.0.3

# The port the front terminates TLS on. This is the origin the page, `/meta`
# and `/session` are all served from.
TLS_PROXY_PORT=8444

# Where the plaintext server is. The demo's selvaged binds its tailnet address
# explicitly, so this names that address — never loopback, which on a shared
# host may be somebody else's server.
TLS_PROXY_BACKEND_HOST=100.64.0.3
TLS_PROXY_BACKEND_PORT=8080

# The certificate the Tailscale MagicDNS name was provisioned with, read
# (never copied) from where `tailscale cert` wrote it. At startup only: a
# renewal needs a restart.
TLS_PROXY_CERT=/home/pi/selvage-web/certs/tailnet.crt
TLS_PROXY_KEY=/home/pi/selvage-web/certs/tailnet.key
