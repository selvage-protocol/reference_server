# Copy to `/srv/selvage/.env` (owner `selvage`, mode 0600). Compose reads it from
# the project directory, so nothing has to be exported.
#
# The images the next `docker compose pull && docker compose up -d` runs, and
# what the update timer follows. `latest` moves with every release; pin a
# service by writing a published version instead (`selvaged:0.4.6`), and unpin
# it by writing `latest` back.

# FSL-1.1-MIT.
SELVAGED_IMAGE=ghcr.io/selvage-protocol/selvaged:latest

# MIT OR Apache-2.0.
SELVAGE_WEB_IMAGE=ghcr.io/selvage-protocol/selvage-web:latest
