# Copy to `/etc/selvage/.env` and fill in. Compose reads this file from the
# project directory, which is the directory the compose file is in, so nothing
# has to be exported and no shell has to have run.
#
# These are the deployment's *intent*: which published images the next
# `docker compose up -d` will run. They are separate from `compose.yaml`
# because they change on a release and the shape does not.
#
# Pin by digest, not by tag. A tag is a name the publisher can repoint, and this
# is the public origin; `ghcr.io/selvage-protocol/selvaged@sha256:…` names one
# immutable manifest. README.md has the two commands that resolve a release tag
# to its index digest through the registry's anonymous pull flow.
#
# A digest that does not exist yet is a normal state for this file to be in
# while a release is in flight; the compose file refuses to start with either
# variable unset rather than falling back to `latest`.

# The server binary. `crates/selvaged` is `FSL-1.1-MIT`.
SELVAGED_IMAGE=ghcr.io/selvage-protocol/selvaged:0.2.0

# The browser client's page. `web_client` is `MIT OR Apache-2.0`.
SELVAGE_WEB_IMAGE=ghcr.io/selvage-protocol/selvage-web:0.1.0
