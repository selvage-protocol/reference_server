# Copy to `/etc/selvage/.env` and fill in. Compose reads this file from the
# project directory, which is the directory the compose file is in, so nothing
# has to be exported and no shell has to have run.
#
# These are the deployment's *intent*: which published images the next
# `docker compose up -d` will run. They are separate from `compose.yaml`
# because they change on a release and the shape does not.
#
# **Digests, not tags**, and the values below are real digests rather than
# placeholders: a tag is a name the publisher can repoint, so a copy of this
# file deployed unchanged would run content nobody reviewed, and `${VAR:?…}`
# in the compose file only catches an empty value. A stale digest fails loudly
# at `docker pull`, which is the right way round. Move both on every release —
# README.md has the two commands that resolve a tag to its index digest through
# the registry's anonymous pull flow.

# selvaged 0.2.0 (ghcr.io/selvage-protocol/selvaged:0.2.0). FSL-1.1-MIT.
SELVAGED_IMAGE=ghcr.io/selvage-protocol/selvaged@sha256:98022660aeb788d27658c54ba0bfce736bc36785b79d0bdc1a4ee15b8a41cc3c

# selvage-web 0.1.0 (ghcr.io/selvage-protocol/selvage-web:0.1.0). MIT OR Apache-2.0.
SELVAGE_WEB_IMAGE=ghcr.io/selvage-protocol/selvage-web@sha256:3ad51c16e0a29e9e8876a20d4b29f0479fe02a0a6b7e424b6b47d1a784c2e422
