# selvaged.env — optional overrides for the selvaged user unit.
#
# Copy to ~/selvage/selvaged.env and edit (see packaging/README.md). Anything
# absent here falls back to the unit's own defaults (loopback :8080, 30 s
# grace), so an empty or missing file is a local-only server.

# The address the server binds. Name an address your guests can reach — never
# loopback when someone else is joining. A tailnet/VPS address goes here
# (e.g. LISTEN_ADDR=192.0.2.10:8080); 0.0.0.0:8080 listens everywhere, and
# then the guests' URL must name the machine, not the wildcard.
LISTEN_ADDR=192.0.2.10:8080

# How long a room survives its host disconnecting, in milliseconds. The 30 s
# default matches the reference behaviour; keep the invite link to reclaim
# inside the window.
ROOM_GRACE_MS=30000
