{
  "id": "016",
  "title": "A request with no `id` is `bad_message`: refused at the handshake, an event once seated",
  "spec": "PROTOCOL.md#41-request-client--server",
  "notes": "The id is the only correlation the wire has, so a request without one is not a request. During the handshake that is fatal like every other handshake fault — `session.error` then close 4000 — and once seated it is an event and the connection stays open, which the follow-up request shows. The frame is otherwise well formed: what is missing is the member the reply would need.",
  "steps": [
    {
      "op": "open",
      "conn": "nameless",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "nameless",
      "refused": true,
      "text": "{\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "nameless",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "nameless",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
