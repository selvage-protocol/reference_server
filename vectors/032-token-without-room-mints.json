{
  "id": "032",
  "title": "A `token` with no `room` mints a fresh room and discards the token",
  "spec": "PROTOCOL.md#51-room-and-token-in-the-connection-url",
  "notes": "The invite URL's two halves can be separated: a URL carrying `token` but no `room` names nothing to join, and PROTOCOL.md §5.1 says the server MUST mint a room for it, seat the connection as that room's host, and discard the token. The mint is the `room.created` reply, whose `token` is the new room's own and never the one in the URL. The later refusal is what proves the discard: a second connection offering the URL's token to the minted room is not this room's token, so it is `token_invalid` and close 4002, the same refusal a wrong token already gets. The final join shows the minted token is the one that works, so the refusal was about that token and not about the room. The minting connection claims `role: \"guest\"`, which §9 ignores: minting is hosting whatever a connection claims.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session?token=deadbeef"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "stranger",
      "target": "/session?room=$room&token=deadbeef"
    },
    {
      "op": "send",
      "conn": "stranger",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Mallory\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "stranger",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"token_invalid\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "stranger",
      "code": 4002
    },
    {
      "op": "open",
      "conn": "invited",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "invited",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "invited",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
