{
  "id": "028",
  "title": "One order decides which of two faults a frame carries is answered",
  "spec": "PROTOCOL.md#11-errors",
  "notes": "The envelope and its id are judged first, then the wire version, then the method: a first frame with no id is bad_message whatever else is wrong with it, and a seated frame that is both an unknown method and selvage/2 is unsupported_version and closes. A method-first dispatcher would answer unknown_method and keep the connection open for that second frame, so the pairing is what pins the order. Each connection carries one pairing.",
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "first",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "first",
      "refused": true,
      "text": "{\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "first",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "first",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "nameless",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "nameless",
      "refused": true,
      "text": "{\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "nameless",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "nameless",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":2,\"method\":\"cursor.teleport\",\"params\":{},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"unsupported_version\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "host",
      "code": 4005
    }
  ]
}
