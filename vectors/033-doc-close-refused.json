{
  "id": "033",
  "title": "A refused `doc.close` is an error response and leaves the connection open",
  "spec": "PROTOCOL.md#docclose",
  "notes": "PROTOCOL.md §9.2 gives `doc.open` and `doc.close` one row: a blank, over-long or control-carrying `path`, or params that do not parse, is the error response `bad_params` on a seated connection, and the connection stays open. Vectors 006 and 029 cover the `doc.open` half; this is the same rule with the method swapped, so a server that validates the path only on open is red here. Four refusals appear — all-whitespace, no `params` at all, a control character, a non-string path — and then a valid `doc.open` proves the connection survived them. The over-long half of §9.2 is deliberately not driven here: §5 leaves the length bound to server policy, so the size that is refused is not the protocol's to fix and a second implementation may legitimately choose another.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":2,\"method\":\"doc.close\",\"params\":{\"path\":\"  \"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":3,\"method\":\"doc.close\",\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":3,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":4,\"method\":\"doc.close\",\"params\":{\"path\":\"src/\\u0001main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":4,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":5,\"method\":\"doc.close\",\"params\":{\"path\":5},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":5,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":6,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":6,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
