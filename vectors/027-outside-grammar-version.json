{
  "id": "027",
  "title": "A version outside the grammar is unsupported_version, at the handshake and seated",
  "spec": "PROTOCOL.md#10-version-and-capability-negotiation",
  "notes": "selvage/01 fails the wireVersion grammar (leading zero), and the failure maps to incompatibility, not to bad_message: at the handshake a session.error refusal closed with 4005, on a seated connection the id-correlated error response followed by the same close.",
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "outside",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "outside",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bad\"},\"v\":\"selvage/01\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "outside",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"unsupported_version\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "outside",
      "code": 4005
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/01\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"unsupported_version\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "host",
      "code": 4005
    }
  ]
}
