{
  "id": "018",
  "title": "The path leaves the room's open-document set when the last holder closes it",
  "spec": "PROTOCOL.md#docclose",
  "notes": "A hold belongs to a connection and the set to the room, so a close removes the path only when no peer still holds it: the first close here releases nothing, the last one takes `a.txt` out for good. The proof that it left rather than merely disappeared from a reply is the next `doc.open`, whose set starts empty — an implementation that kept the path would answer with it still in front.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"a.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"a.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"a.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"a.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"b.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"a.txt\",\"b.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"a.txt\",\"b.txt\"],\"path\":\"b.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"a.txt\",\"b.txt\"],\"path\":\"b.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":3,\"method\":\"doc.close\",\"params\":{\"path\":\"b.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":3,\"result\":{\"documents\":[\"a.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"b.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"b.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":4,\"method\":\"doc.close\",\"params\":{\"path\":\"a.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":4,\"result\":{\"documents\":[\"a.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"a.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[\"a.txt\"],\"path\":\"a.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":3,\"method\":\"doc.close\",\"params\":{\"path\":\"a.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":3,\"result\":{\"documents\":[]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[],\"path\":\"a.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.closed\",\"params\":{\"documents\":[],\"path\":\"a.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":4,\"method\":\"doc.open\",\"params\":{\"path\":\"c.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":4,\"result\":{\"documents\":[\"c.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"c.txt\"],\"path\":\"c.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"c.txt\"],\"path\":\"c.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
