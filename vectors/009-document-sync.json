{
  "id": "009",
  "title": "A document sync exchange, byte for byte, including a UTF-16 offset",
  "spec": "PROTOCOL.md#7-document-sync",
  "notes": "The server never decodes a binary frame: every frame here is asserted as the exact bytes on the wire. The host's replica holds `a😀bc`; its local edit inserts `X` at index 4, which is UTF-16 code units, so it lands after the `b`. A byte-offset implementation would insert it after the emoji, and the guest's text would differ. The guest replies with a SyncStep1 carrying an empty state vector, which is three varints and no payload: `00 00 01 00`. The last two steps assert convergence: identical text and equal state vectors.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "sendBinary",
      "conn": "guest",
      "hex": "00 00 01 00"
    },
    {
      "op": "expectBinary",
      "conn": "host",
      "hex": "00 00 01 00"
    },
    {
      "op": "sendBinary",
      "conn": "host",
      "hex": "00 01 1b 01 01 01 00 04 01 0b 73 72 63 2f 6d 61 69 6e 2e 72 73 07 61 f0 9f 98 80 62 63 00",
      "apply": true
    },
    {
      "op": "expectBinary",
      "conn": "guest",
      "hex": "00 01 1b 01 01 01 00 04 01 0b 73 72 63 2f 6d 61 69 6e 2e 72 73 07 61 f0 9f 98 80 62 63 00",
      "apply": true
    },
    {
      "op": "expectDoc",
      "conn": "guest",
      "path": "src/main.rs",
      "text": "a😀bc"
    },
    {
      "op": "sendBinary",
      "conn": "host",
      "hex": "00 02 0c 01 01 01 05 c4 01 03 01 04 01 58 00",
      "apply": true
    },
    {
      "op": "expectBinary",
      "conn": "guest",
      "hex": "00 02 0c 01 01 01 05 c4 01 03 01 04 01 58 00",
      "apply": true
    },
    {
      "op": "expectDoc",
      "conn": "guest",
      "path": "src/main.rs",
      "text": "a😀bXc"
    },
    {
      "op": "sendBinary",
      "conn": "guest",
      "hex": "00 02 0a 01 01 02 00 44 01 00 01 21 00",
      "apply": true
    },
    {
      "op": "expectBinary",
      "conn": "host",
      "hex": "00 02 0a 01 01 02 00 44 01 00 01 21 00",
      "apply": true
    },
    {
      "op": "expectDoc",
      "conn": "host",
      "path": "src/main.rs",
      "text": "!a😀bXc"
    },
    {
      "op": "expectDoc",
      "conn": "guest",
      "path": "src/main.rs",
      "text": "!a😀bXc"
    },
    {
      "op": "expectSameState",
      "conns": [
        "host",
        "guest"
      ]
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
