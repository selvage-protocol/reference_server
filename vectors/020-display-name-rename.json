{
  "id": "020",
  "title": "A peer renames itself mid-session, the room is told, and a refused name changes nothing",
  "spec": "PROTOCOL.md#sessionrename--the-live-rename",
  "notes": "Two clients. The guest renames itself with session.rename; the mover is answered with {result:{}} and then receives peer.renamed for itself, and the host receives the same peer.renamed: a rename is announced to every peer, the mover included. An over-long name (31 ASCII characters and one astral character: 32 code points but 33 UTF-16 code units, one over) is refused with an error response carrying bad_params, and the connection stays open: a seated request fault does not close, unlike the same name in session.hello (vector 019). A subsequent rename to `Rob` succeeds, and a second rename to `Rob` is still announced, so a no-op rename is not suppressed. The bound is the handshake's: non-blank and at most 32 UTF-16 code units.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\"],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\"},\"token\":\"$token\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\"],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\"}},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\"}},\"v\":\"selvage/2\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":2,\"method\":\"session.rename\",\"params\":{\"display_name\":\"Robert\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":2,\"result\":{},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Robert\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Robert\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "refused": true,
      "text": "{\"id\":3,\"method\":\"session.rename\",\"params\":{\"display_name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa𝄞\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":3,\"v\":\"selvage/2\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":4,\"method\":\"session.rename\",\"params\":{\"display_name\":\"Rob\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":4,\"result\":{},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Rob\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Rob\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":5,\"method\":\"session.rename\",\"params\":{\"display_name\":\"Rob\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":5,\"result\":{},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Rob\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.renamed\",\"params\":{\"display_name\":\"Rob\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/2\"}"
    }
  ],
  "selvage": "selvage/2",
  "canonical": "SJ-C/1"
}
