{
  "id": "023",
  "title": "A malformed grant, and a grant from a guest, are `bad_params` and leave the connection open",
  "spec": "PROTOCOL.md#docgrant",
  "notes": "Four bad requests from the host — a `paths` that is not an array, one member that is not a string, one blank path, and no `params` at all — are each answered with an error response carrying `bad_params`, correlated by the request's `id`, and none of them closes the connection: a fault on a seated connection is an error response, not a refusal (contrast vectors 005 and 017). They are sent knowing they do not conform, so they carry `refused` and their params are not schema-checked. The guest's own `doc.grant` is well formed and is refused all the same, because a grant is the host's: §11 has no code for \"not permitted\", so it is refused with the code a malformed request gets, and its params are schema-checked because nothing about the frame itself is wrong. The last publication is the proof that every connection survived and that no refused request had an effect: the room's grant was empty until it.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":2,\"method\":\"doc.grant\",\"params\":{\"paths\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.grant\",\"params\":{\"paths\":\"src/main.rs\"},\"v\":\"selvage/1\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":3,\"method\":\"doc.grant\",\"params\":{\"paths\":[\"src/main.rs\",7]},\"v\":\"selvage/1\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":3,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":4,\"method\":\"doc.grant\",\"params\":{\"paths\":[\"src/main.rs\",\"   \"]},\"v\":\"selvage/1\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":4,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":5,\"method\":\"doc.grant\",\"v\":\"selvage/1\"}",
      "refused": true
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":5,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":6,\"method\":\"doc.grant\",\"params\":{\"paths\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":6,\"result\":{},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.granted\",\"params\":{\"paths\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.granted\",\"params\":{\"paths\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
