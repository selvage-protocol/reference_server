{
  "id": "014",
  "title": "A second connection claiming `host` while a host is present is `host_present`, close 4004",
  "spec": "PROTOCOL.md#9-rooms-and-the-lifecycle",
  "notes": "The host role is claimed, not proven, but only one connection may hold it at a time: a claim while a host is seated is refused with close 4004 and the room is left exactly as it was. The host's `doc.open` afterwards is one proof that the refusal touched nothing, and the second guest's `room.joined` the other: the room still admits, and its `peers` array lists both peers in whatever order the server happens to build.",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "usurper",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "usurper",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Mallory\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "usurper",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"host_present\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "usurper",
      "code": 4004
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "cleo",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "cleo",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Cleo\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "cleo",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[\"src/main.rs\"],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Cleo\",\"peer_id\":\"$cleo_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Cleo\",\"peer_id\":\"$cleo_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Cleo\",\"peer_id\":\"$cleo_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
