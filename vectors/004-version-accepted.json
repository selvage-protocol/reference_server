{
  "id": "004",
  "title": "Any `selvage/1.x` is accepted, and the server answers in its own version",
  "spec": "PROTOCOL.md#10-version-and-capability-negotiation",
  "notes": "At major 1 the rule is same-major, so the minor is not decisive: `selvage/1.9` and `selvage/1.0` both seat. The reply's `v` is the server's version, not the client's.",
  "steps": [
    {
      "op": "open",
      "conn": "minor19",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "minor19",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Minor\"},\"v\":\"selvage/1.9\"}"
    },
    {
      "op": "expect",
      "conn": "minor19",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room_19\",\"self\":{\"display_name\":\"Minor\",\"peer_id\":\"$minor_peer_19\",\"role\":\"host\"},\"token\":\"$token_19\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "minor10",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "minor10",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Minor\"},\"v\":\"selvage/1.0\"}"
    },
    {
      "op": "expect",
      "conn": "minor10",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room_10\",\"self\":{\"display_name\":\"Minor\",\"peer_id\":\"$minor_peer_10\",\"role\":\"host\"},\"token\":\"$token_10\"},\"v\":\"selvage/1\"}"
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
