{
  "id": "012",
  "title": "The room outlives a dropped host for the grace period, and the host reclaims it",
  "spec": "PROTOCOL.md#91-reconnecting",
  "notes": "The host leaves, the remaining peer is told `peer.left` and then `host.detached` with the grace period, and a connection claiming `host` with the token is seated before it expires and inherits the room's document set. Reclaiming is a join: the reply is `room.joined`, and it carries no `token`. When the reclaimed host leaves too, the grace period runs out and the room is destroyed: `room.gone`, close 4003, and a later join with the same URL is `room_unknown`. A reclaiming host needs the token, and only `room.created` ever carried it, which is why the second host's hello is the invite URL's token and not a remembered room id alone.",
  "harness": {
    "room_grace_ms": 400
  },
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "close",
      "conn": "host"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.left\",\"params\":{\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"host.detached\",\"params\":{\"grace_ms\":400},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "claimant",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "claimant",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "claimant",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[\"src/main.rs\"],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"host.attached\",\"params\":{\"peer\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "close",
      "conn": "claimant"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.left\",\"params\":{\"peer_id\":\"$claimant_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"host.detached\",\"params\":{\"grace_ms\":400},\"v\":\"selvage/1\"}"
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.gone\",\"params\":{\"reason\":\"$_\",\"room_id\":\"$room\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "guest",
      "code": 4003
    },
    {
      "op": "open",
      "conn": "late",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "late",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Late\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "late",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"room_unknown\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "late",
      "code": 4001
    }
  ],
  "selvage": "selvage/1",
  "canonical": "SJ-C/1"
}
