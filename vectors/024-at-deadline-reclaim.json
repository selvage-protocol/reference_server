{
  "id": "024",
  "title": "A reclaim just before the deadline seats, and the armed reap never fires",
  "spec": "PROTOCOL.md#9-rooms-and-the-lifecycle",
  "notes": "The host leaves with a 2 s grace; 1.5 s later a host claimant reclaims and inherits the document set. 0.8 s after that \u2014 past the original deadline but inside the fresh one \u2014 a guest still opens a document, which proves the stale reap timer never fired: seating superseded it. A hello at or after destruction is refused room_unknown instead, as vectors/012's tail shows.",
  "harness": {
    "room_grace_ms": 2000
  },
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "open",
      "conn": "guest",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Bob\",\"role\":\"guest\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"d.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"d.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"d.txt\"],\"path\":\"d.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"d.txt\"],\"path\":\"d.txt\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "close",
      "conn": "host"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.left\",\"params\":{\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"host.detached\",\"params\":{\"grace_ms\":2000},\"v\":\"selvage/1\"}"
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "open",
      "conn": "claimant",
      "target": "/session?room=$room&token=$token"
    },
    {
      "op": "send",
      "conn": "claimant",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "claimant",
      "text": "{\"event\":\"room.joined\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[\"d.txt\"],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[{\"display_name\":\"Bob\",\"peer_id\":\"$guest_peer\",\"role\":\"guest\"}],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"host.attached\",\"params\":{\"peer\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"peer.joined\",\"params\":{\"peer\":{\"display_name\":\"Ada\",\"peer_id\":\"$claimant_peer\",\"role\":\"host\"}},\"v\":\"selvage/1\"}"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "send",
      "conn": "guest",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"e.txt\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"d.txt\",\"e.txt\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "guest",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"d.txt\",\"e.txt\"],\"path\":\"e.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "claimant",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"d.txt\",\"e.txt\"],\"path\":\"e.txt\",\"peer_id\":\"$guest_peer\"},\"v\":\"selvage/1\"}"
    }
  ]
}
