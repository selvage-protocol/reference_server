{
  "id": "031",
  "title": "A frame that repeats a JSON member name is `bad_message`",
  "spec": "PROTOCOL.md#4-session-envelope",
  "notes": "A JSON object is a set of member names: PROTOCOL.md §4 forbids the same name twice at any depth, so a receiver never lets a parser's last-wins or first-wins decide what a frame says. The refusal is `bad_message` before any other fault the frame carries (§11), and the seated half shows that it is an event which leaves the connection open — including for a name repeated inside `params`, which is where a reader that only walks the envelope's own members stops looking. The last request holds the same path the repeated frames named, so the room is shown untouched by the two refusals.",
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "repeated",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "repeated",
      "refused": true,
      "text": "{\"id\":1,\"id\":2,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "repeated",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "repeated",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":2,\"method\":\"doc.open\",\"method\":\"doc.close\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":3,\"method\":\"doc.open\",\"params\":{\"path\":\"a.rs\",\"path\":\"b.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":4,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":4,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    }
  ]
}
