{
  "id": "030",
  "title": "A text frame that is not one JSON object is `bad_message`",
  "spec": "PROTOCOL.md#4-session-envelope",
  "notes": "Every text frame is one JSON object, and a frame that is not one is refused `bad_message` — the code the frame's shape earns, whatever it would have said. Before seating that is a refusal: `session.error` and close 4000. Once seated the same fault is an event and the connection stays open, which the request after it shows. The truncated frame is not JSON at all and the array is JSON of the wrong shape; both are one case for the receiver, so both are pinned. `error.message` carries the parser's own words, which is why it is matched as `$_`.",
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "truncated",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "truncated",
      "refused": true,
      "unparsable": true,
      "text": "{\"id\":1,\"method\":"
    },
    {
      "op": "expect",
      "conn": "truncated",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "truncated",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "array",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "array",
      "refused": true,
      "text": "[1,2,3]"
    },
    {
      "op": "expect",
      "conn": "array",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "array",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "[1,2,3]"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_message\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":2,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    }
  ]
}
