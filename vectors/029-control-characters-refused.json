{
  "id": "029",
  "title": "A control character in a `display_name`, a `path` or a grant member is `bad_params`",
  "spec": "PROTOCOL.md#5-methods",
  "notes": "PROTOCOL.md §5 makes a `display_name`, a `path` and each member of a grant's `paths` free of the Unicode `Cc` category — C0 (U+0000–U+001F), DELETE (U+007F) and C1 (U+0080–U+009F) — and fixes the refusal as `bad_params`: before seating that closes the connection, and on a seated connection an error response that leaves it open. Each frame is written the way CANONICAL.md §2.3 writes the character, so the refusal is about the value and not its spelling (CANONICAL.md §2.8), and the last request shows the same server carrying a path that is only non-blank. Every value here holds its control character away from an edge, where the refusal cannot be confused with the blank rule `NOTES.md` §B.8 leaves open: each is non-blank under any reading and no `trim` removes what it holds. The grant's C1 member is written as itself in UTF-8, which is what §2.3 requires of a character above U+001F — a check that stops at C0 accepts a value the prose forbids.",
  "selvage": "selvage/1",
  "canonical": "SJ-C/1",
  "steps": [
    {
      "op": "open",
      "conn": "bell",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "bell",
      "refused": true,
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"A\\u0001da\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "bell",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "bell",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "tab",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "tab",
      "refused": true,
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"A\\tda\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "tab",
      "text": "{\"event\":\"session.error\",\"params\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expectClose",
      "conn": "tab",
      "code": 4000
    },
    {
      "op": "open",
      "conn": "host",
      "target": "/session"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":1,\"method\":\"session.hello\",\"params\":{\"display_name\":\"Ada\",\"role\":\"host\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"room.created\",\"params\":{\"capabilities\":[\"y-protocols/1\",\"awareness\",\"open-document-set\",\"host-reclaim\"],\"documents\":[],\"keepalive\":{\"awareness_expire_ms\":30000,\"awareness_renew_ms\":15000,\"ping_interval_ms\":30000},\"peers\":[],\"room_id\":\"$room\",\"self\":{\"display_name\":\"Ada\",\"peer_id\":\"$host_peer\",\"role\":\"host\"},\"token\":\"$token\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":2,\"method\":\"doc.open\",\"params\":{\"path\":\"src/\\u0001main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":2,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":3,\"method\":\"doc.open\",\"params\":{\"path\":\"src/\\nmain.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":3,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "refused": true,
      "text": "{\"id\":4,\"method\":\"doc.grant\",\"params\":{\"paths\":[\"docs/readme.md\",\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"error\":{\"code\":\"bad_params\",\"message\":\"$_\"},\"id\":4,\"v\":\"selvage/1\"}"
    },
    {
      "op": "send",
      "conn": "host",
      "text": "{\"id\":5,\"method\":\"doc.open\",\"params\":{\"path\":\"src/main.rs\"},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"id\":5,\"result\":{\"documents\":[\"src/main.rs\"]},\"v\":\"selvage/1\"}"
    },
    {
      "op": "expect",
      "conn": "host",
      "text": "{\"event\":\"doc.opened\",\"params\":{\"documents\":[\"src/main.rs\"],\"path\":\"src/main.rs\",\"peer_id\":\"$host_peer\"},\"v\":\"selvage/1\"}"
    }
  ]
}
